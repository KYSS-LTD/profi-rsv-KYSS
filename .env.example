APP_ENV=development
DEBUG=true

POSTGRES_DB=komandus
POSTGRES_USER=komandus
POSTGRES_PASSWORD=komandus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
