# Backend API. Для Docker/nginx обычно достаточно /api
VITE_API_BASE_URL=/api

# Dev proxy target для npm run dev
VITE_DEV_API_TARGET=http://localhost:8000

# true = работать без backend на демо-данных
VITE_USE_MOCKS=true

# Заголовок, в который frontend отправляет Telegram initData на backend
VITE_TELEGRAM_AUTH_HEADER=X-Telegram-Init-Data

# Имя приложения в PWA-манифесте
VITE_APP_NAME=Командус
